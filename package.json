{
  "name": "wohills-contests",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w apps/parade --",
    "build": "npm run build --workspaces --if-present",
    "lint": "eslint .",
    "preview": "npm run preview -w apps/parade --",
    "set-window": "npm run set-window -w apps/parade",
    "seed-floats": "npm run seed-floats -w apps/parade",
    "seed-float-images": "npm run seed-float-images -w apps/parade",
    "test": "vitest run"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vitest": "^5.1.0"
  }
}
