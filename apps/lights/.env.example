# Local: values from `supabase status`. Hosted: your project's URL and publishable key.
VITE_SUPABASE_URL=http://127.0.0.1:55321
VITE_SUPABASE_ANON_KEY=

# Contest settings, applied to lights.settings with
# `npm run contest-admin -- --contest lights` (service-role key; never ship it to a browser).
# Only variables that are set are applied; an empty timestamp clears that bound.
SUPABASE_SERVICE_ROLE_KEY=
SUBMISSIONS_OPEN_AT=2026-11-28T00:00:00-05:00
SUBMISSIONS_CLOSE_AT=2026-12-16T00:00:00-05:00
VOTING_OPENS_AT=2026-12-08T00:00:00-05:00
VOTING_CLOSES_AT=2026-12-21T00:00:00-05:00
